---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { assertUniqueWorkSlugs, imageUrl, readerPages } from '../../lib/content';

export async function getStaticPaths() {
  const works = await getCollection('works');
  assertUniqueWorkSlugs(works);
  return works.map((work) => ({ params: { work: work.data.slug }, props: { work } }));
}
interface Props { work: CollectionEntry<'works'>; }
const { work } = Astro.props;
const formatter = new Intl.DateTimeFormat('ja-JP', { dateStyle: 'long' });
const firstPage = readerPages(work)[0];
---
<BaseLayout title={work.data.title} description={work.data.description}>
  <section class="page-section">
    <div class="detail">
      <img src={imageUrl(`${work.data.slug}/${work.data.covers.front}`)} alt={`${work.data.title}の表紙`} decoding="async" />
      <div>
        <h1>{work.data.title}</h1>
        <p class="meta"><time datetime={work.data.publishedAt.toISOString()}>{formatter.format(work.data.publishedAt)}</time> · {work.data.pages}ページ</p>
        <p class="description">{work.data.description}</p>
        <a class="read" href={`/${work.data.slug}/${firstPage.route}/`}>最初から読む</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .detail { display: grid; gap: 1rem; }
  .detail > img { width: min(100%, 360px); aspect-ratio: 3 / 4; object-fit: cover; border: 1px solid var(--white); background: var(--black); }
  h1 { margin: 0 0 1rem; padding: .5rem 0 .5rem .6rem; border-left: 10px solid var(--pink); font-family: 'Zen Old Mincho', serif; font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.4; }
  .meta { color: var(--gray); font-size: .85rem; }
  .description { max-width: 620px; margin-block: 1.5rem 2rem; line-height: 1.9; white-space: pre-wrap; }
  .read { display: inline-flex; min-height: 48px; align-items: center; padding: 0 1.5rem; border: 1px solid var(--white); color: var(--white); font-weight: 700; text-decoration: none; }
  .read:hover { border-color: var(--pink); }
  @media (min-width: 720px) { .detail { grid-template-columns: minmax(220px, 340px) 1fr; align-items: center; gap: 2rem; } }
</style>
