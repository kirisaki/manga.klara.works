---
import type { Work } from '../lib/content';
import { imageUrl } from '../lib/content';
interface Props { work: Work; }
const { work } = Astro.props;
---
<article class="card">
  <a href={`/${work.data.slug}/`}>
    <div class="cover"><img src={imageUrl(`${work.data.slug}/${work.data.covers.front}`)} alt={`${work.data.title}の表紙`} loading="lazy" decoding="async" /></div>
    <div class="copy"><h2>{work.data.title}</h2><p>{work.data.description}</p></div>
  </a>
</article>
<style>
  .card { height: 100%; overflow: hidden; border: 1px solid var(--white); }
  .card a { display: flex; height: 100%; flex-direction: column; padding: .65rem; text-decoration: none; }
  .cover { aspect-ratio: 3 / 4; overflow: hidden; background: var(--black); }
  img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .copy { padding: .35rem; }
  h2 { margin: .5rem 0 .25rem; padding-left: .4rem; border-left: 3px solid var(--pink); font-size: 1.25rem; font-weight: 400; line-height: 1.6; }
  p { margin: 0; color: var(--white); line-height: 1.6; }
  a:hover p { color: var(--dark); }
</style>
