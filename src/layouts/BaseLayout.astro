---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title, description = 'Klara Works 漫画作品ページ' } = Astro.props;
const pageTitle = title ? `${title} - Klara Works 漫画作品ページ` : 'Klara Works 漫画作品ページ';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fc2063" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400&family=M+PLUS+1p&family=Zen+Old+Mincho:wght@700&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="container shell">
      <header class="site-header"><h1><a href="/">Klara Works 漫画作品ページ</a></h1></header>
      <main><slot /></main>
    </div>
  </body>
</html>
<style>
  .shell { min-height: 100vh; background: var(--dark); }
  .site-header { min-height: 4rem; display: flex; align-items: end; border-bottom: 1px solid var(--white); padding-inline: 1rem; }
  .site-header h1 { margin: 0; font-family: 'Zen Old Mincho', serif; font-size: clamp(1.45rem, 3.3vw, 2.5rem); font-weight: 700; letter-spacing: -.08em; line-height: 4rem; }
  .site-header a { text-decoration: none; }
  @media (max-width: 560px) { .site-header h1 { line-height: 1.35; padding-block: 1rem; } }
</style>
